# Copy to .env and fill locally. Never commit .env.
# Use unquoted single-line values without inline comments.
# Docker Compose reads .env; import it into each Java service terminal (see README).
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Base64-encoded random key of at least 32 bytes; shared by auth and public gateway.
JWT_SECRET=
# Required for model generation; the two internal tokens must differ (32+ chars).
LLM_API_KEY=
LLM_GATEWAY_TOKEN=
GENERATION_SERVICE_TOKEN=
# Required for running generated strategies in E2B.
E2B_API_KEY=
